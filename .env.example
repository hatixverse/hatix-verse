# Resend (https://resend.com). Create the key with "Sending access"; never commit it.
RESEND_API_KEY=
# Verified sending domain/subdomain in Resend, e.g. HATIX <noreply@mail.hatixverse.com>
CONTACT_FROM_EMAIL=
# Where enquiries are delivered (use your Gmail until contact@ can receive mail)
CONTACT_TO_EMAIL=
# Optional: where visitor replies to the acknowledgement go (defaults to CONTACT_TO_EMAIL)
CONTACT_REPLY_TO=
NEXT_PUBLIC_SITE_URL=https://example.com
